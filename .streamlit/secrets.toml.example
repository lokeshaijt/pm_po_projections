# Copy this file to .streamlit/secrets.toml locally, or paste its contents
# into the "Secrets" box in Streamlit Community Cloud's app settings.
# Never commit a real secrets.toml to git.

smtp_host = "smtp.gmail.com"
smtp_port = 587
smtp_username = "you@yourcompany.com"
smtp_password = "your-app-password"

# Optional: starting email IDs, loaded when supplier_emails.json doesn't exist
# yet. Separate several IDs with commas. After that, manage them in the app.
[supplier_emails]
"Abirami Packaging" = "abirami@example.com"
"Arr Print Pack" = "arr@example.com"
"Mayura Packaging" = "mayura@example.com"
"SRI RANGA INDUSTRIES" = "sriranga@example.com"
"Sri Venkateswara Packings" = "venkateswara@example.com"
"Lovely Offset Printers (P) Ltd" = "lovely@example.com"
"Salem Print Pack" = "salem@example.com"
"Shraddha Saburi Printers Private Limited" = "shraddha@example.com"
